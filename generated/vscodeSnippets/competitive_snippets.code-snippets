< cap[vertDepthMin][iVertex]", "\t\t\t\t\t&& flowDijDepth[iVertex] > edgeCost(vertDepthMin, iVertex) + cost[vertDepthMin][iVertex]) {", "\t\t\t\tflowDijDepth[iVertex] = edgeCost(vertDepthMin, iVertex) + cost[vertDepthMin][iVertex];", "\t\t\t\tflowDijNext[iVertex] = -vertDepthMin - 1;", "\t\t\t}", "\t\t}", "\t}", "", "\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\tif (label[iVertex] < INF) {", "\t\t\tlabel[iVertex] += flowDijDepth[iVertex];", "\t\t}", "\t}", "", "\treturn flowDijNext[puit] >= 0;", "}", "", "pair<int, int> getMinCostMaxFlow() { // return {min_cost, max_flow}", "\tfill(flowOnEdge[0], flowOnEdge[0] + MAX_VERTICES*MAX_VERTICES, 0);", "\tfill(label, label + MAX_VERTICES, 0);", "", "\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\tfor (int iNext = 0; iNext < nbVertices; iNext++) {", "\t\t\tif (cap[iVertex][iNext] || cap[iNext][iVertex]) {", "\t\t\t\tvertexVois[iVertex].push_back(iNext);", "\t\t\t}", "\t\t}", "\t}", "", "\tint flow = 0, flowCost = 0;", "", "\twhile (canPushWithDijkstra()) {", "\t\tint capMinPath = INF;", "\t\tfor (int iVertex = puit, iNext = flowDijNext[iVertex]; iVertex != source; iVertex = iNext, iNext = flowDijNext[iVertex]) {", "\t\t\tif (flowOnEdge[iVertex][iNext]) {", "\t\t\t\tcapMinPath = min(capMinPath, flowOnEdge[iVertex][iNext]);", "\t\t\t} else {", "\t\t\t\tcapMinPath = min(capMinPath, cap[iNext][iVertex] - flowOnEdge[iNext][iVertex]);", "\t\t\t}", "\t\t}", "", "\t\t// update the flow network", "\t\tfor (int iVertex = puit, iNext = flowDijNext[iVertex]; iVertex != source; iVertex = iNext, iNext = flowDijNext[iVertex]) {", "\t\t\tif (flowOnEdge[iVertex][iNext]) {", "\t\t\t\tflowOnEdge[iVertex][iNext] -= capMinPath;", "\t\t\t\tflowCost -= capMinPath * cost[iVertex][iNext];", "\t\t\t} else {", "\t\t\t\tflowOnEdge[iNext][iVertex] += capMinPath;", "\t\t\t\tflowCost += capMinPath * cost[iNext][iVertex];", "\t\t\t}", "\t\t}", "", "\t\tflow += capMinPath;", "\t}", "", "\treturn {flowCost, flow};", "}", ""], "description": "", "scope": "cpp"}, "algo_min_cut_sparse": {"prefix": "algo_min_cut_sparse", "body": ["vector<Edge> minCutEdges;", "vector<int> minCutIsVisited;", "", "void minCutMarkNodes(int iVertex) {", "\tif (!minCutIsVisited[iVertex]) {", "\t\tminCutIsVisited[iVertex] = true;", "\t\tfor (auto& e : flowEdges[iVertex]) {", "\t\t\tif (e.flow < e.cap) {", "\t\t\t\tminCutMarkNodes(e.to);", "\t\t\t}", "\t\t}", "\t}", "}", "", "int getMinCut() { // Require algo_flow_sparse, return maxFlow, min cut is in minCutEdges", "\tint maxFlow = getMaxFlow();", "\tfill(minCutIsVisited.begin(), minCutIsVisited.end(), false);", "\tminCutIsVisited.resize(nbVertices, false);", "\tminCutEdges.clear();", "", "\tminCutMarkNodes(source);", "", "\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\tif (minCutIsVisited[iVertex]) {", "\t\t\tfor (auto& e : flowEdges[iVertex]) {", "\t\t\t\tif (!minCutIsVisited[e.to]) {", "\t\t\t\t\tminCutEdges.emplace_back(e);", "\t\t\t\t}", "\t\t\t}", "\t\t}", "\t}", "\treturn maxFlow;", "}"], "description": "", "scope": "cpp"}, "algo_flow_sparse": {"prefix": "algo_flow_sparse", "body": ["/* Min cost Max Flow algorithm using Dijkstra on a graph represented with an adjacency list */", "struct Edge { int from, to, cap, flow, reversedId; };", "", "int nbVertices=0, nbEdges, source, puit; // Init with values", "int maxEdgeCapInGraph = 0;", "vector<vector<Edge>> flowEdges;", "vector<int> lastDfs;", "", "void addVertex(int from, int to, int cap) {", "\tflowEdges.resize(max((int)flowEdges.size(), max(from+1, to+1)));", "\tflowEdges[from].emplace_back(Edge{from, to, cap, 0, (int)flowEdges[to].size()});", "\tflowEdges[to].emplace_back(Edge{to, from, 0, 0, (int)flowEdges[from].size()-1});", "\tmaxEdgeCapInGraph = max(maxEdgeCapInGraph, cap);", "}", "", "int maxFlowCanPush(int pos, int minCap, int minOnPath, int dfsId) {", "\tif (pos == puit) return minOnPath;", "\tif (lastDfs[pos] == dfsId) return 0;", "\tlastDfs[pos] = dfsId;", "\tfor (Edge& e : flowEdges[pos]) {", "\t\tif (e.cap - e.flow >= minCap) {", "\t\t\tint flow = maxFlowCanPush(e.to, minCap, min(minOnPath, e.cap-e.flow), dfsId);", "\t\t\tif (flow) {", "\t\t\t\te.flow += flow;", "\t\t\t\tflowEdges[e.to][e.reversedId].flow -= flow;", "\t\t\t\treturn flow;", "\t\t\t}", "\t\t}", "\t}", "\treturn 0;", "}", "", "int getMaxFlow() { // return {minCost, maxFlow}", "\tnbVertices = max(nbVertices, (int)flowEdges.size());", "\tflowEdges.resize(nbVertices); lastDfs.resize(nbVertices, -1);", "", "\tint dfsId = 0, maxFlow = 0, pushFlow = 1;", "\twhile (pushFlow * 2 <= maxEdgeCapInGraph) { pushFlow *= 2; }", "", "\twhile (pushFlow) {", "\t\tint pushed = maxFlowCanPush(source, pushFlow, INF, dfsId++);", "\t\tif (pushed) maxFlow += pushed;", "\t\telse pushFlow /= 2;", "\t}", "\treturn maxFlow;", "}", "", "// void readMaxFlow() {", "// \tcin >> nbVertices >> nbEdges >> source >> puit;", "", "// \tfor (int iEdge = 0; iEdge < nbEdges; iEdge++) {", "// \t\tint vertex1, vertex2, capVertex;", "// \t\tcin >> vertex1 >> vertex2 >> capVertex;", "", "// \t\taddVertex(vertex1, vertex2, capVertex);", "// \t}", "// }"], "description": "", "scope": "cpp"}, "algo_min_cost_max_flow_sparse": {"prefix": "algo_min_cost_max_flow_sparse", "body": ["/* Min cost Max Flow algorithm using Dijkstra on a graph represented with an adjacency list */", "struct Edge { int from, to, cap, cost, flow, reversedId; };", "", "int nbVertices=0, nbEdges, source, puit; // Init with values", "vector<vector<Edge>> flowEdges;", "", "void addVertex(int from, int to, int cap, int cost) {", "\tflowEdges.resize(max((int)flowEdges.size(), max(from+1, to+1)));", "\tflowEdges[from].emplace_back(Edge{from, to, cap, cost, 0, (int)flowEdges[to].size()});", "\tflowEdges[to].emplace_back(Edge{to, from, 0, -cost, 0, (int)flowEdges[from].size()-1});", "}", "", "// Used internally by the algorithm", "vector<int> potential, distMin;", "vector<Edge*> dijPrev;", "", "struct FlowSit { int pos, time; };", "bool operator < (const FlowSit& a, const FlowSit& b) {", "\treturn a.time > b.time;", "}", "", "bool canPushDijPath() {", "\tfill(distMin.begin(), distMin.end(), INF);", "\tdistMin[source] = 0;", "", "\tpriority_queue<FlowSit> sits;", "\tsits.push({source, 0});", "\twhile (!sits.empty()) { // Dijkstra", "\t\tint pos = sits.top().pos, time = sits.top().time;", "\t\tsits.pop();", "\t\tif (time == distMin[pos]) {", "\t\t\tfor (int iEdge = 0; iEdge < (int)flowEdges[pos].size(); iEdge++) {", "\t\t\t\tEdge& e = flowEdges[pos][iEdge];", "\t\t\t\tif (e.cap - e.flow) {", "\t\t\t\t\tint t2 = time + e.cost + potential[e.from] - potential[e.to];", "\t\t\t\t\tif (t2 < distMin[e.to]) {", "\t\t\t\t\t\tdijPrev[e.to] = &flowEdges[pos][iEdge];", "\t\t\t\t\t\tdistMin[e.to] = t2;", "\t\t\t\t\t\tsits.push({e.to, t2});", "\t\t\t\t\t}", "\t\t\t\t}", "\t\t\t}", "\t\t}", "\t}", "\treturn distMin[puit] != INF;", "}", "", "pair<int, int> getMinCostMaxFlow() { // return {minCost, maxFlow}", "\tnbVertices = max(nbVertices, (int)flowEdges.size());", "\tpotential.resize(nbVertices, 0); distMin.resize(nbVertices);", "\tflowEdges.resize(nbVertices); dijPrev.resize(nbVertices, nullptr);", "", "\tint minCost = 0, maxFlow = 0;", "\twhile (canPushDijPath()) {", "\t\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\t\tpotential[iVertex] += distMin[iVertex];", "\t\t}", "\t\tint delta = INF;", "\t\tfor (int iVertex = puit; iVertex != source; iVertex = dijPrev[iVertex]->from) {", "\t\t\tdelta = min(delta, dijPrev[iVertex]->cap - dijPrev[iVertex]->flow);", "\t\t}", "\t\tfor (int iVertex = puit; iVertex != source; iVertex = dijPrev[iVertex]->from) {", "\t\t\tdijPrev[iVertex]->flow += delta;", "\t\t\tflowEdges[iVertex][dijPrev[iVertex]->reversedId].flow -= delta;", "\t\t\tminCost += delta * dijPrev[iVertex]->cost;", "\t\t}", "\t\tmaxFlow += delta;", "\t}", "\treturn {minCost, maxFlow};", "}", "", "// void readMinCostFlow() {", "// \tcin >> nbVertices >> nbEdges >> source >> puit;", "", "// \tfor (int iEdge = 0; iEdge < nbEdges; iEdge++) {", "// \t\tint vertex1, vertex2, capVertex, costVertex;", "// \t\tcin >> vertex1 >> vertex2 >> capVertex >> costVertex;", "", "// \t\taddVertex(vertex1, vertex2, capVertex, costVertex);", "// \t}", "// }"], "description": "", "scope": "cpp"}, "algo_min_cost_max_flow_negative": {"prefix": "algo_min_cost_max_flow_negative", "body": ["/* Min cost Max Flow algorithm using Dijkstra and bellman-ford. Works with negative weights */", "struct Edge { int from, to, cap, cost, flow, reversedId; };", "", "int nbVertices=0, nbEdges, source, puit; // Init with values", "vector<vector<Edge>> flowEdges;", "", "void addVertex(int from, int to, int cap, int cost) {", "\tflowEdges.resize(max((int)flowEdges.size(), max(from+1, to+1)));", "\tflowEdges[from].emplace_back(Edge{from, to, cap, cost, 0, (int)flowEdges[to].size()});", "\tflowEdges[to].emplace_back(Edge{to, from, 0, -cost, 0, (int)flowEdges[from].size()-1});", "}", "", "// Used internally by the algorithm", "vector<int> potential, distMin;", "vector<Edge*> dijPrev;", "", "struct FlowSit { int pos, time; };", "bool operator < (const FlowSit& a, const FlowSit& b) {", "\treturn a.time > b.time;", "}", "", "void initWithBellmanFord() {", "\tfill(distMin.begin(), distMin.end(), INF);", "\tdistMin[source] = 0;", "\tfor (int step = 0; step < nbVertices-1; step++) {", "\t\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\t\tif (distMin[iVertex] != INF) {", "\t\t\t\tfor (Edge& e : flowEdges[iVertex]) {", "\t\t\t\t\tdistMin[e.to] = min(distMin[e.to], distMin[iVertex] + e.cost);", "\t\t\t\t}", "\t\t\t}", "\t\t}", "\t}", "\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\tpotential[iVertex] = distMin[iVertex];", "\t}", "}", "", "bool canPushDijPath() {", "\tfill(distMin.begin(), distMin.end(), INF);", "\tdistMin[source] = 0;", "", "\tpriority_queue<FlowSit> sits;", "\tsits.push({source, 0});", "\twhile (!sits.empty()) { // Dijkstra", "\t\tint pos = sits.top().pos, time = sits.top().time;", "\t\tsits.pop();", "\t\tif (time == distMin[pos]) {", "\t\t\tfor (int iEdge = 0; iEdge < (int)flowEdges[pos].size(); iEdge++) {", "\t\t\t\tEdge& e = flowEdges[pos][iEdge];", "\t\t\t\tif (e.cap - e.flow) {", "\t\t\t\t\tint t2 = time + e.cost + potential[e.from] - potential[e.to];", "\t\t\t\t\tif (t2 < distMin[e.to]) {", "\t\t\t\t\t\tdijPrev[e.to] = &flowEdges[pos][iEdge];", "\t\t\t\t\t\tdistMin[e.to] = t2;", "\t\t\t\t\t\tsits.push({e.to, t2});", "\t\t\t\t\t}", "\t\t\t\t}", "\t\t\t}", "\t\t}", "\t}", "\treturn distMin[puit] != INF;", "}", "", "pair<int, int> getMinCostMaxFlow() { // return {minCost, maxFlow}", "\tnbVertices = max(nbVertices, (int)flowEdges.size());", "\tpotential.resize(nbVertices, 0); distMin.resize(nbVertices);", "\tflowEdges.resize(nbVertices); dijPrev.resize(nbVertices, nullptr);", "", "\tint minCost = 0, maxFlow = 0;", "\tinitWithBellmanFord();", "\twhile (canPushDijPath()) {", "\t\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\t\tpotential[iVertex] += distMin[iVertex];", "\t\t}", "\t\tint delta = INF;", "\t\tfor (int iVertex = puit; iVertex != source; iVertex = dijPrev[iVertex]->from) {", "\t\t\tdelta = min(delta, dijPrev[iVertex]->cap - dijPrev[iVertex]->flow);", "\t\t}", "\t\tfor (int iVertex = puit; iVertex != source; iVertex = dijPrev[iVertex]->from) {", "\t\t\tdijPrev[iVertex]->flow += delta;", "\t\t\tflowEdges[iVertex][dijPrev[iVertex]->reversedId].flow -= delta;", "\t\t\tminCost += delta * dijPrev[iVertex]->cost;", "\t\t}", "\t\tmaxFlow += delta;", "\t}", "\treturn {minCost, maxFlow};", "}", "", "// void readMinCostFlow() {", "// \tcin >> nbVertices >> nbEdges >> source >> puit;", "", "// \tfor (int iEdge = 0; iEdge < nbEdges; iEdge++) {", "// \t\tint vertex1, vertex2, capVertex, costVertex;", "// \t\tcin >> vertex1 >> vertex2 >> capVertex >> costVertex;", "", "// \t\taddVertex(vertex1, vertex2, capVertex, costVertex);", "// \t}", "// }"], "description": "", "scope": "cpp"}, "algo_flow": {"prefix": "algo_flow", "body": ["const int MAX_NODES = 501;", "const bool IS_FLOW_ORIENTED = true;", "int sourceId = 1, puitId = 1;", "", "int cap[MAX_NODES][MAX_NODES];", "int flow[MAX_NODES][MAX_NODES];", "int flowExploMark[MAX_NODES];", "int flowExploMarkId = 1;", "int nbNodes, nbArcs;", "", "struct __Flow__init {", "\t__Flow__init() {", "\t\tfor (int l = 0; l < MAX_NODES; l++) {", "\t\t\tfill(cap[l], cap[l]+MAX_NODES, 0);", "\t\t\tfill(flow[l], flow[l]+MAX_NODES, 0);", "\t\t}", "\t\tfill(flowExploMark, flowExploMark+MAX_NODES, 0);", "\t}", "} __flow__init;", "", "bool pushFlow(int node, int push) {", "\tif (node == puitId) {", "\t\treturn true;", "\t} else if (flowExploMark[node] == flowExploMarkId) {", "\t\treturn false;", "\t}", "\tflowExploMark[node] = flowExploMarkId;", "\tfor (int v = 0; v < MAX_NODES; v++) {", "\t\tif (flow[node][v] + push <= cap[node][v]) {", "\t\t\tif (pushFlow(v, push)) {", "\t\t\t\tflow[node][v] += push;", "\t\t\t\tflow[v][node] -= push;", "\t\t\t\treturn true;", "\t\t\t}", "\t\t}", "\t}", "\treturn false;", "}", "", "int getMaxFlow() {", "\tint tryToPush = 1;", "\tint capMax = 0;", "\tfor (int el1 = 0; el1 < MAX_NODES; el1++) {", "\t\tcapMax = max(capMax, *max_element(cap[el1], cap[el1]+MAX_NODES));", "\t}", "\twhile (tryToPush*2 <= capMax) {", "\t\ttryToPush *= 2;", "\t}", "\tint pushedFlow = 0;", "\twhile (tryToPush) {", "\t\twhile (++flowExploMarkId && pushFlow(sourceId, tryToPush)) {", "\t\t\tpushedFlow += tryToPush;", "\t\t\tif (pushedFlow >= INF) {", "\t\t\t\treturn INF;", "\t\t\t}", "\t\t}", "\t\ttryToPush /= 2;", "\t}", "\treturn pushedFlow;", "}", ""], "description": "\"flow\" will contain the flow passing through an edge (positive or negative).", "scope": "cpp"}, "geo_convex_hull": {"prefix": "geo_convex_hull", "body": ["// Minimum convex hull. Requires geo_base", "", "vector<Vect> halfMinimumCvx(vector<Vect>& points, bool alreadySorted=false) {", "\tvector<Vect> hull;", "\tif (!alreadySorted) {", "\t\tsort(points.begin(), points.end()); // Sort by x", "\t}", "\tfor (Vect& pt : points) {", "\t\twhile (hull.size() >= 2) {", "\t\t\tconst Vect& a = hull[hull.size()-2], b = hull.back();", "\t\t\tif (det(b-a, pt-a) < 0) { // '<=' may bause bugs", "\t\t\t\tbreak;", "\t\t\t}", "\t\t\thull.pop_back();", "\t\t}", "\t\thull.emplace_back(pt);", "\t}", "\treturn hull;", "}", "", "vector<Vect> minConvexHull(vector<Vect> points) {", "\tsort(points.begin(), points.end());", "\tvector<Vect> points1, points2;", "\tpoints1.emplace_back(points[0]);", "\tpoints2.emplace_back(Vect{points[0].x, -points[0].y});", "", "\tfor (auto& pt : points) {", "\t\tvint side = det(points.back()-points[0], pt-points[0]);", "\t\tif (side > 0) points1.emplace_back(pt);", "\t\telse if (side < 0) points2.emplace_back(Vect{pt.x, -pt.y});", "\t}", "\tpoints1.emplace_back(points.back());", "\tpoints2.emplace_back(Vect{points.back().x, -points.back().y});", "", "\tvector<Vect> hull1 = halfMinimumCvx(points1, true);", "\tvector<Vect> hull2 = halfMinimumCvx(points2, true);", "", "\tfor (int i = (int)hull2.size()-2; i > 0; i--) {", "\t\thull1.emplace_back(Vect{hull2[i].x, -hull2[i].y});", "\t}", "\treturn hull1;", "}", "", "vfloat hullPerimeter(const vector<Vect>& hull) {", "\tif (hull.empty()) { return 0; }", "\tvfloat per = (hull.back()-hull[0]).norm();", "\tfor (int i = 0; i < (int)hull.size()-1; i++) {", "\t\tper += (hull[i+1]-hull[i]).norm();", "\t}", "\treturn per;", "}"], "description": "", "scope": "cpp"}, "geo_segs": {"prefix": "geo_segs", "body": ["// Geometry functions for segments. Requires geo_base", "", "struct Seg {", "\tVect pt1, pt2;", "\tvfloat normSquare() { return (pt2-pt1).normSquare(); }", "\tvfloat norm() { return (pt2-pt1).norm(); }", "\tvfloat distTo(Vect pt) {", "\t\tvfloat proj = projOnLineDistOriented(pt, pt1, pt2);", "\t\tif (proj >= 0 && proj <= this->norm()) {", "\t\t\treturn abs(distLineOriented(pt, pt1, pt2));", "\t\t}", "\t\treturn min((pt-pt1).norm(), (pt-pt2).norm());", "\t}", "\tbool isOnLine(Vect point) { return det(point-pt1, pt2-pt1) == 0; }", "\tbool isOnSeg(Vect point) {", "\t\tauto v = (point-pt1) * (pt2-pt1);", "\t\treturn det(point-pt1, pt2-pt1) == 0 && v >= 0 && v <= this->normSquare();", "\t}", "};", "ostream& operator<<(ostream& os, const Seg& s) { os << s.pt1 << \" \" << s.pt2; return os; }", "istream& operator>>(istream& is, Seg& s) { is >> s.pt1 >> s.pt2; return is; }", "vfloat distLineOriented(const Vect& point, const Seg& s) { return distLineOriented(point, s.pt1, s.pt2); }", "vfloat projOnLineDistOriented(const Vect& p, const Seg& s){return projOnLineDistOriented(p, s.pt1, s.pt2);}", "", "Vect intersetLines(const Seg& a, const Seg& b) { // Works only if vint = float / double", "\treturn b.pt1 + (det(a.pt2-a.pt1, a.pt2-b.pt1) / (vfloat)det(a.pt2-a.pt1, b.pt2-b.pt1)) * (b.pt2-b.pt1);", "}", "bool isThereIntersection(const Seg& a, const Seg& b) {", "\tif (det(a.pt2-a.pt1, b.pt2-b.pt1) == 0) return false;", "\tvfloat t1 = (vfloat)det(a.pt2-a.pt1, a.pt2-b.pt1) / (vfloat)det(a.pt2-a.pt1, b.pt2-b.pt1);", "\tvfloat t2 = (vfloat)det(b.pt2-b.pt1, b.pt2-a.pt1) / (vfloat)det(b.pt2-b.pt1, a.pt2-a.pt1);", "\treturn 0 <= t1 && t1 <= 1 && 0 <= t2 && t2 <= 1;", "}"], "description": "", "scope": "cpp"}, "geo_shapes": {"prefix": "geo_shapes", "body": ["// Geometric shapes functions. Requires geo_base + geo_segs", "", "vector<Seg> borderToSegs(const vector<Vect>& border) {", "\tvector<Seg> v;", "\tif (border.size() >= 2) {", "\t\tv.emplace_back(Seg{border.back(), border[0]});", "\t}", "\tfor (int i = 0; i < (int)border.size()-1; i++) {", "\t\tv.emplace_back(Seg{border[i], border[i+1]});", "\t}", "\treturn v;", "}", "", "vector<bool> arePointsInArea(const vector<Vect>& border, const vector<Vect>& points) {", "\tauto segs = borderToSegs(border);", "\tvector<bool> ans;", "\tans.reserve(border.size());", "\tfor (auto& pt : points) {", "\t\tSeg s = {pt, Vect{pt.x+1, INF}};", "\t\tbool inArea = false;", "\t\tfor (auto& seg : segs) {", "\t\t\tif (seg.isOnSeg(pt)) {", "\t\t\t\tinArea = true;", "\t\t\t