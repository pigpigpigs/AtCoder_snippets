eturn false;", "\t}", "\treturn true;", "}", "", "$0"], "description": "", "scope": "cpp"}, "str_carttree": {"prefix": "str_carttree", "body": ["// WIP", "", "template<class T> struct CartTree { // Not persistant", "\tT val;", "\tint weight; // min weight on top", "\tCartTree* left;", "\tCartTree* right;", "\tint _size;", "\tbool reverse;", "", "\tCartTree(T value) : val(value), left(nullptr), right(nullptr), _size(1), reverse(false) { weight = rand(); }", "\tpair<CartTree*, CartTree*> split(T splitVal, bool includeVal=false) {", "\t\t// tree1 < splitVal <= tree2 if includeVal=false, tree1 <= splitVal < tree2 otherwise", "\t\tthis->propagNode();", "\t\tif (val < splitVal || (includeVal && !(splitVal < val))) {", "\t\t\tCartTree* right2 = nullptr;", "\t\t\tif (right != nullptr) {", "\t\t\t\tauto p = right->split(splitVal, includeVal);", "\t\t\t\tright = p.first;", "\t\t\t\tright2 = p.second;", "\t\t\t}", "\t\t\tthis->updateNode();", "\t\t\treturn {this, right2};", "\t\t}", "\t\tCartTree* left1 = nullptr;", "\t\tif (left != nullptr) {", "\t\t\tauto p = left->split(splitVal, includeVal);", "\t\t\tleft1 = p.first;", "\t\t\tleft = p.second;", "\t\t}", "\t\tthis->updateNode();", "\t\treturn {left1, this};", "\t}", "\t~CartTree() { delete left; delete right; }", "\tinline int size() const {return this->_size;}", "", "\tstatic CartTree* merge(CartTree* a, CartTree* b) {", "\t\tif (a == nullptr) { return b; } if (b == nullptr) { return a; }", "\t\tif (a->weight < b->weight) {", "\t\t\ta->propagNode();", "\t\t\ta->right = CartTree::merge(a->right, b);", "\t\t\ta->updateNode();", "\t\t\treturn a;", "\t\t}", "\t\tb->propagNode();", "\t\tb->left = CartTree::merge(a, b->left);", "\t\tb->updateNode();", "\t\treturn b;", "\t}", "\tCartTree* mergeLeft(CartTree* a) {return CartTree::merge(a, this); }", "\tCartTree* mergeRight(CartTree* b) {return CartTree::merge(this, b); }", "", "\tvoid propagNode() {", "\t\tif (reverse) {", "\t\t\treverse=false;", "\t\t\tif (left!=nullptr) { left->reverse = !left->reverse; }", "\t\t\tif (right!=nullptr) { right->reverse = !right->reverse; }", "\t\t}", "\t}", "\tvoid updateNode() {", "\t\t// Overwrides must start with CartTree::updateNode();", "\t\tthis->_size = 1 + (left==nullptr?0:left->_size) + (right==nullptr?0:right->_size);", "\t\tthis->propagNode();", "\t}", "", "\tinline static int empty(CartTree* a) {return a!=nullptr;}", "\tinline static int size(CartTree* a) {return a==nullptr?0:a->size();}", "", "\tCartTree* insert(CartTree* node) {", "\t\tauto p = this->split(node->val);", "\t\treturn node->mergeLeft(p.first)->mergeRight(p.second);", "\t}", "\tCartTree* insert(T value) { return this->insert(new CartTree(value)); }", "\tstatic CartTree* insert(CartTree* tree, T value) {return tree==nullptr?new CartTree(value):tree->insert(value);}", "\tCartTree* remove(T value) { // Remove all nodes with this value", "\t\tauto p1 = this->split(value);", "\t\tauto p2 = p1.second->split(value);", "\t\tdelete p2.first;", "\t\treturn p1.first->mergeRight(p2.second);", "\t}", "", "\tT& getNthValue(int n) {", "\t\tint leftSize = CartTree::size(left);", "\t\tif (leftSize > n) {", "\t\t\treturn left->getNthValue(n);", "\t\t} else if (leftSize == n) {", "\t\t\treturn val;", "\t\t}", "\t\tif (right == nullptr) {", "\t\t\tcerr << \"Error CartTree getNthValue\\n\";", "\t\t}", "\t\treturn right->getNthValue(n-leftSize-1);", "\t}", "};// Usage : CartTree<int>* t = nullptr; and then build", "// using Tree = CartTree<int>; // Tree* t = nullptr;", "template<class T> ostream& operator<<(ostream& os, const CartTree<T>* t) {", "\tif (t != nullptr) {", "\t\tos << \"[\" << t->left << \"] - \";", "\t\tos << \"(\" << t->val << \" ; size=\" << t->_size << \")\";", "\t\tos << \" - [\" << t->right << \"]\";", "\t} return os;", "}"], "description": "", "scope": "cpp"}, "str_bigint": {"prefix": "str_bigint", "body": ["class Bigint;", "Bigint abs(Bigint);", "std::string to_string(Bigint const &);", "Bigint big_factorial(int);", "", "class Bigint { public:", "    //Constructors", "    Bigint(); Bigint(long long); Bigint(std::string); Bigint(const Bigint& b);", "    //Access", "    int operator[](int const &);", "    //Helpers", "    void clear();", "    Bigint &abs();", "    //Power", "    Bigint &pow(int const &);", "    //Trivia", "    int digits() const;", "    int trailing_zeros() const;", "", "friend std::istream &operator>>(std::istream &, Bigint &);friend std::ostream &operator<<(std::ostream &, Bigint const &);Bigint operator+(Bigint const &) const;Bigint &operator+=(Bigint const &);Bigint operator+(long long const &) const;Bigint &operator+=(long long);Bigint operator-(Bigint const &) const;Bigint &operator-=(Bigint const &);Bigint operator*(Bigint const &);Bigint &operator*=(Bigint const &);Bigint operator*(long long const &);Bigint &operator*=(int const &);bool operator<(const Bigint &) const;bool operator>(const Bigint &) const;bool operator<=(const Bigint &) const;bool operator>=(const Bigint &) const;bool operator==(const Bigint &) const;bool operator!=(const Bigint &) const;Bigint operator=(const long long &);private:std::vector<int> number;bool positive;int base;unsigned int skip;static const int default_base=1000000000;private:int segment_length(int) const;Bigint pow(int const &, std::map<int, Bigint> &);int compare(Bigint const &) const;};Bigint::Bigint(){positive = true;base = Bigint::default_base;skip = 0;}Bigint::Bigint(const Bigint &b) : number(b.number), positive(b.positive), base(b.base), skip(b.skip) { }Bigint::Bigint(long long value){base = Bigint::default_base;skip = 0;if (value < 0) {positive = false;value *= -1;} else {positive = true;}while (value) {number.push_back((int) (value % base));value /= base;}}Bigint::Bigint(std::string stringInteger){int size = stringInteger.length();base = Bigint::default_base;skip = 0;positive = (stringInteger[0] != '-');while (true) {if (size <= 0) break;if (!positive && size <= 1) break;int length = 0;int num = 0;int prefix = 1;for (int i(size - 1); i >= 0 && i >= size - 9; --i) {if (stringInteger[i] < '0' || stringInteger[i] > '9') break;num += (stringInteger[i] - '0') * prefix;prefix *= 10;++length;}number.push_back(num);size -= length;}}Bigint Bigint::operator+(Bigint const &b) const{Bigint c = *this;c += b;return c;}Bigint &Bigint::operator+=(Bigint const &b){if (!b.positive) {return *this -= b;}std::vector<int>::iterator it1 = number.begin();std::vector<int>::const_iterator it2 = b.number.begin();int sum = 0;while (it1 != number.end() || it2 != b.number.end()) {if (it1 != number.end()) {sum += *it1;} else {number.push_back(0);it1 = number.end()-1;}if (it2 != b.number.end()) {sum += *it2;++it2;}*it1 = sum % base;++it1;sum /= base;}if (sum) number.push_back(1);return *this;}Bigint Bigint::operator+(long long const &b) const{Bigint c = *this;c += b;return c;}Bigint &Bigint::operator+=(long long b){std::vector<int>::iterator it = number.begin();if (skip > number.size()) {number.insert(number.end(), skip - number.size(), 0);}it += skip;bool initial_flag=true;while (b || initial_flag) {initial_flag=false;if (it != number.end()) {*it += b % base;b /= base;b += *it / base;*it %= base;++it;} else {number.push_back(0);it = number.end() - 1;}}return *this;}Bigint Bigint::operator-(Bigint const &b) const{Bigint c = *this;c -= b;return c;}Bigint &Bigint::operator-=(Bigint const &b){std::vector<int>::iterator it1 = number.begin();std::vector<int>::const_iterator it2 = b.number.begin();int dif = 0;while (it1 != number.end() || it2 != b.number.end()) {if (it1 != number.end()) {dif += *it1;++it1;}if (it2 != b.number.end()) {dif -= *it2;++it2;}if (dif < 0) {*(it1 - 1) = dif + base;dif = -1;} else {*(it1 - 1) = dif % base;dif /= base;}}if (dif < 0) positive = false;if (number.size() > 1){do{it1 = number.end() - 1;if (*it1 == 0) number.pop_back();else break;} while (number.size() > 1);}return *this;}Bigint Bigint::operator*(Bigint const &b){if (b.number.size() == 1) return *this *= b.number[0];std::vector<int>::iterator 