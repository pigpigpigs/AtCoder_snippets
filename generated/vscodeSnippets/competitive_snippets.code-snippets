 b, const int delta) {", "\tif (flowOnEdge[b][a] > 0) {", "\t\tflowOnEdge[b][a] -= delta;", "\t\treturn - delta * cost[b][a];", "\t}", "\tflowOnEdge[a][b] += delta;", "\treturn delta * cost[a][b];", "}", "", "bool canPushDijPath() {", "\tfill(distMin, distMin+MAX_VERTICES, INF);", "\tdistMin[source] = 0;", "", "\tpriority_queue<FlowSit> sits;", "\tsits.push({source, 0});", "\twhile (!sits.empty()) { // Dijkstra", "\t\tint pos = sits.top().pos, time = sits.top().time;", "\t\tsits.pop();", "\t\tif (time == distMin[pos]) {", "\t\t\tfor (int v : vertexVois[pos]) {", "\t\t\t\tauto capCost = getEdgeCapCost(pos, v);", "\t\t\t\tif (capCost.first) {", "\t\t\t\t\tint t2 = time + capCost.second;", "\t\t\t\t\tif (t2 < distMin[v]) {", "\t\t\t\t\t\tdijPrev[v] = pos;", "\t\t\t\t\t\tdistMin[v] = t2;", "\t\t\t\t\t\tsits.push({v, t2});", "\t\t\t\t\t}", "\t\t\t\t}", "\t\t\t}", "\t\t}", "\t}", "\treturn distMin[puit] != INF;", "}", "", "pair<int, int> getMinCostMaxFlow() { // return {minCost, maxFlow}", "\tfill(flowOnEdge[0], flowOnEdge[0]+MAX_VERTICES*MAX_VERTICES, 0);", "\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\tfor (int iVois = 0; iVois < nbVertices; iVois++) {", "\t\t\tif (cap[iVertex][iVois] != 0 || cap[iVois][iVertex] != 0) {", "\t\t\t\tvertexVois[iVertex].emplace_back(iVois);", "\t\t\t}", "\t\t}", "\t}", "\tint minCost = 0, maxFlow = 0;", "\twhile (canPushDijPath()) {", "\t\tfor (int iVertex = 0; iVertex < nbVertices; iVertex++) {", "\t\t\tpotential[iVertex] += distMin[iVertex];", "\t\t}", "\t\tint delta = INF;", "\t\tfor (int iVertex = puit; iVertex != source; iVertex = dijPrev[iVertex]) {", "\t\t\tauto capCost = getEdgeCapCost(dijPrev[iVertex], iVertex);", "\t\t\tdelta = min(delta, capCost.first);", "\t\t}", "\t\tfor (int iVertex = puit; iVertex != source; iVertex = dijPrev[iVertex]) {", "\t\t\tminCost += updateAndCost(dijPrev[iVertex], iVertex, delta);", "\t\t}", "\t\tmaxFlow += delta;", "\t}", "\treturn {minCost, maxFlow};", "}"], "description": "", "scope": "cpp"}, "algo_max_flow": {"prefix": "algo_max_flow", "body": ["def max_flow_of_graph(edges, sources, sinks):", "\t# Edges should be a list of (from, to, flow_cap)", "\tflow = {}", "\tcapacity = {}", "\tvoisins = {}", "\tif len(sinks) > 5:", "\t\tsinks = set(sinks)", "\tfor e_from, e_to, _ in edges:", "\t\tcapacity[(e_from, e_to)] = 0", "\t\tcapacity[(e_to, e_from)] = 0", "\t\tflow[(e_from, e_to)] = 0", "\t\tflow[(e_to, e_from)] = 0", "\t\tvoisins[e_to] = []", "\t\tvoisins[e_from] = []", "\tfor e_from, e_to, e_cap in edges:", "\t\tcapacity[(e_from, e_to)] += e_cap", "\t\tvoisins[e_to].append(e_from)", "\t\tvoisins[e_from].append(e_to)", "", "\tcap_max = max(capacity.values())", "\ttry_to_push = 2**int(log2(max(1, cap_max)))", "\tpushed_flow = 0", "", "\twhile try_to_push:", "\t\tfor src in sources:", "\t\t\tpushed = False", "\t\t\tstack = [(src, 0)]", "\t\t\tseen_nodes = set([src])", "\t\t\twhile stack and not pushed:", "\t\t\t\tnode, i_vois = stack.pop()", "\t\t\t\tif node in sinks:", "\t\t\t\t\tpushed = True", "\t\t\t\t\tstack.append((node, 0))", "\t\t\t\t\tbreak", "", "\t\t\t\twhile (i_vois < len(voisins[node])", "\t\t\t\t\tand capacity[(node, voisins[node][i_vois])] - flow[(node, voisins[node][i_vois])] < try_to_push):", "\t\t\t\t\ti_vois += 1 # We want only the residual edges (capacity >= try_to_push)", "\t\t\t\tif i_vois < len(voisins[node]):", "\t\t\t\t\tnext_node = voisins[node][i_vois]", "\t\t\t\t\tstack.append((node, i_vois+1))", "\t\t\t\t\tif not next_node in seen_nodes:", "\t\t\t\t\t\tstack.append((next_node, 0))", "\t\t\t\t\t\tseen_nodes.add(next_node)", "", "\t\t\tif pushed:", "\t\t\t\tpushed_flow += try_to_push", "\t\t\t\tfor (e1, _), (e2, _) in zip(stack, stack[1:]):", "\t\t\t\t\tflow[(e1, e2)] += try_to_push", "\t\t\t\t\tflow[(e2, e1)] -= try_to_push", "\t\t\t\tbreak", "\t\telse:", "\t\t\ttry_to_push //= 2", "", "\treturn pushed_flow, flow, capacity", ""], "description": "", "scope": "python"}, "str_segtree_max": {"prefix": "str_segtree_max",